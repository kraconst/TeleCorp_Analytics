# Server
HTTP_ADDR=:8080

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=telecorp
DB_PASSWORD=telecorp_secret
DB_NAME=telecorp_db
DB_SSLMODE=disable

# Telegram Development CLI (cmd/telegram-dev)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Use proxy: true or false (set false when using system VPN)
USE_PROXY=false
# SOCKS5 / HTTP proxy (e.g. socks5://127.0.0.1:1080 or http://user:password@host:port)
TELEGRAM_PROXY=
# Use a different session file for each account.
TELEGRAM_SESSION_PATH=./var/telegram/account-a.session

# AI summaries (RFC 02, track 2A). Empty AI_API_KEY disables AI: generate returns 503.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Model name of the OpenAI-compatible provider (required to enable AI, no default).
AI_MODEL=
# Request timeout (Go duration, at most 5m). HTTP WriteTimeout and HTTP shutdown wait = AI_TIMEOUT + 5s (plus up to 5s for the background worker).
AI_TIMEOUT=30s
AI_MAX_MESSAGES=50
AI_MAX_CHARS=12000
